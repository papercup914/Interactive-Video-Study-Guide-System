# ==============================================================================
# Interactive Video Study Guide System - Backend Environment Variables (.env)
# ==============================================================================

# Application Environment (development / production)
APP_ENV=production

# Supabase JWT Secret (From Supabase Project Settings > Authentication > JWT Keys > Legacy JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-legacy-jwt-secret-here

# Gemini API Key (For study guide generation & discussion tutor)
GEMINI_API_KEY=your-gemini-api-key-here

# Redis Broker URL (For Celery async task queue)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS Allowed Origins (Comma-separated URLs, e.g. https://your-app.vercel.app,http://localhost:3000)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Optional: Set to 'true' to disable auth during offline testing
DISABLE_AUTH=false

# Optional: YouTube Bot Detection Bypass Cookies (Netscape formatted string or use backend/data/cookies.txt)
# YOUTUBE_COOKIES_TEXT=
