        guide.document = json.dumps(document, ensure_ascii=False)
        guide.notes = json.dumps(notes, ensure_ascii=False)
        db.commit()
        return True

def create_job(job_id: str) -> None:
    with SessionLocal() as db:
        new_job = Job(id=job_id, status="pending", progress="")
        db.add(new_job)
        db.commit()

