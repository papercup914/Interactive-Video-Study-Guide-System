      `Fallback timeSeries points generated: ${res.timeSeries.length}`
    );
  } catch (err: any) {
    assert(false, `Invalid TimeRange: ${JSON.stringify(tr)}`, `CRASHED with error: ${err.message}`);
  }
});

// ------------------------------------------------------------------
