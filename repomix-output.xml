def cancel_batch_job(batch_id: str) -> None:
    with SessionLocal() as db:
        job = db.query(BatchJob).filter(BatchJob.id == batch_id).first()
        if job:
            job.status = "cancelled"
            job.updated_at = datetime.now().isoformat()
