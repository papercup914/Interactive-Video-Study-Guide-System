const LENGTH_PRESETS = ["핵심 요약", "적당한 설명", "아주 상세하게"] as const;
const ANALOGY_PRESETS = ["비유 없이 담백하게", "적절한 비유 추가", "풍부한 비유"] as const;

export type PresetInfo = {
