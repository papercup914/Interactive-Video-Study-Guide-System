# ==============================================================================
# Backend Dockerfile for Interactive Video Study Guide System
# Python 3.12 Slim base image
# ==============================================================================

FROM python:3.12-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Install minimal system dependencies (curl for healthcheck, ffmpeg for yt-dlp audio extraction)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/backend/requirements.txt

# Copy source code and data directories
COPY backend/ /app/backend/
COPY data/ /app/data/

# Create necessary directories
RUN mkdir -p /app/backend/data /app/backend/tmp /app/data

# Expose FastAPI default port
EXPOSE 8000

# Default command: launch FastAPI server via uvicorn
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
